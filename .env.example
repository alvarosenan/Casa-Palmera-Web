# Copia este archivo como .env y rellena tus propias claves.
# Ninguna de estas variables es obligatoria para que la web funcione;
# solo son necesarias cuando conectes cada integración.

# Google Maps (sección "Mapa" — mapa interactivo)
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics (medición de visitas)
VITE_GA_MEASUREMENT_ID=

# Formulario de contacto (por ejemplo, Formspree, o tu propio backend)
VITE_CONTACT_FORM_ENDPOINT=

# WhatsApp Business (número en formato internacional, sin espacios)
VITE_WHATSAPP_NUMBER=

# Enlaces a sistemas de reserva
VITE_BOOKING_URL=
VITE_AIRBNB_URL=
